# =============================================================================
# FinTrader Hub — Environment Variables
# Copy to .env and fill in values. Never commit real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Application (optional — defaults shown)
# -----------------------------------------------------------------------------
APP_NAME=FinTrader Hub
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# -----------------------------------------------------------------------------
# PostgreSQL (required)
# -----------------------------------------------------------------------------
POSTGRES_USER=fintrader
POSTGRES_PASSWORD=fintrader_secret
POSTGRES_DB=fintraderhub
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Required. Must start with postgresql://
DATABASE_URL=postgresql://fintrader:fintrader_secret@postgres:5432/fintraderhub

# -----------------------------------------------------------------------------
# Redis (required for cache, Celery, rate limiting in multi-instance setups)
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# Celery (required for background tasks)
# -----------------------------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# -----------------------------------------------------------------------------
# JWT Authentication (required)
# -----------------------------------------------------------------------------
# Required. Minimum 32 characters.
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# Market Data Providers (optional — empty disables provider)
# -----------------------------------------------------------------------------
FINNHUB_API_KEY=
COINGECKO_API_KEY=
ALPHA_VANTAGE_API_KEY=
EXCHANGE_RATE_API_KEY=

# -----------------------------------------------------------------------------
# Market Tasks & Cache (optional)
# -----------------------------------------------------------------------------
MARKET_PRICE_UPDATE_MINUTES=5
NEWS_FEED_UPDATE_MINUTES=30
NEWS_EXPIRATION_DAYS=30
MARKET_PRICE_CACHE_TTL_SECONDS=60

# -----------------------------------------------------------------------------
# Risk (optional)
# -----------------------------------------------------------------------------
RISK_FREE_RATE=0.0

# -----------------------------------------------------------------------------
# Email Notifications via Resend (required at startup)
# -----------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ALERT_EMAIL=

# -----------------------------------------------------------------------------
# Settings / API Key Encryption (required at startup)
# -----------------------------------------------------------------------------
# Required. Valid Fernet key. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
API_KEY_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Logging (optional)
# -----------------------------------------------------------------------------
# text = human-readable (development), json = structured (production)
LOG_FORMAT=text
# Leave empty to auto-select: DEBUG in development, INFO in production
LOG_LEVEL=

# -----------------------------------------------------------------------------
# Security (optional)
# -----------------------------------------------------------------------------
# Comma-separated origins, or * for all (development only)
CORS_ORIGINS=*
AUTH_RATE_LIMIT_PER_MINUTE=10

# -----------------------------------------------------------------------------
# Startup validation (optional — for tests/CI only)
# -----------------------------------------------------------------------------
SKIP_STARTUP_VALIDATION=false
# Skip Alembic upgrade on API lifespan (tests/CI; Docker prod should stay false)
SKIP_AUTO_MIGRATIONS=false
